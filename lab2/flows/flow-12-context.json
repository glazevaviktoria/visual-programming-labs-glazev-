        "id": "465610201aea3bc1",
        "type": "function",
        "z": "88d99ef3d96a93d5",
        "name": "flow counter",
        "func": "// Получаем текущее значение счетчика из flow context\nlet counter = flow.get(\"counter\") || 0;\n\n// Увеличиваем счетчик на 1\ncounter = counter + 1;\n\n// Сохраняем новое значение обратно в flow context\nflow.set(\"counter\", counter);\n\n// Формируем ответ\nmsg.payload = {\n    counter: counter,\n    message: \"Счётчик увеличен на 1\",\n    timestamp: new Date().toISOString()\n};\nreturn msg;",
