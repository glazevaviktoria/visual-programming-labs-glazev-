    {
        "id": "97ec814c06084705",
        "type": "function",
        "z": "18f1489ecc4b46fa",
        "name": "function 3",
        "func": "// Проверяем, где лежит текст (зависит от версии ноды)\nlet userText = \"\";\nlet chatId = \"\";\n\nif (msg.payload && msg.payload.content) {\n    userText = msg.payload.content;\n    chatId = msg.payload.chatId;\n} else if (msg.originalMessage && msg.originalMessage.text) {\n    userText = msg.originalMessage.text;\n    chatId = msg.originalMessage.chat.id;\n}\n\n// Если текст не найден — останавливаемся\nif (!userText) {\n    node.warn(\"Текст сообщения не найден!\");\n    return null;\n}\n\n// Формируем ответ\nmsg.payload = {\n    chatId: chatId,\n    type: \"message\",\n    content: \"Эхо: \" + userText\n};\n\nreturn msg;",
